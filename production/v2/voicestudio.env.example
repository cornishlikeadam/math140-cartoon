# Add these to the root .env after selecting three saved profiles in VoiceStudio.
VOICESTUDIO_BASE_URL=http://127.0.0.1:3900/v1
VOICESTUDIO_MODEL=omnivoice
# Actual profile IDs, not OpenAI aliases or display names.
VOICESTUDIO_VOICE_KJ=
VOICESTUDIO_VOICE_PROF=
VOICESTUDIO_VOICE_BOT=
# Only needed when your VoiceStudio backend requires authentication.
VOICESTUDIO_API_KEY=
