{
  "name": "math140-cartoon",
  "version": "1.0.0",
  "description": "Math 140: friendly anime cartoon v2 with VoiceStudio and reusable multi-engine production assets",
  "repository": {},
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@react-three/fiber": "9.2.0",
    "@remotion/cli": "4.0.534",
    "@remotion/google-fonts": "4.0.534",
    "@remotion/media": "4.0.534",
    "@remotion/three": "4.0.534",
    "@remotion/zod-types": "4.0.534",
    "mediabunny": "1.56.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.534",
    "three": "0.178.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.534",
    "@types/react": "19.2.7",
    "@types/three": "0.170.0",
    "@types/web": "0.0.166",
    "eslint": "9.39.5",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio",
    "build": "remotion bundle",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc",
    "doctor": "node scripts/doctor.mjs",
    "script:check": "node scripts/validate-script.mjs",
    "voices": "node scripts/voice.mjs",
    "lipsync": "node scripts/lipsync.mjs",
    "timing": "node scripts/timing.mjs",
    "audio": "node scripts/audio.mjs",
    "manim": "bash scripts/manim/render.sh",
    "produce:audio": "npm run script:check && npm run voices && npm run lipsync && npm run timing",
    "qa:pre": "node scripts/qa.mjs pre",
    "previews": "bash scripts/previews.sh",
    "render": "npm run v2:render",
    "qa:post": "node scripts/qa.mjs post out/final.mp4",
    "produce": "npm run v2:audio && npm run v2:export && npm run v2:render",
    "v2:script:check": "MATH140_EDITION=v2 node scripts/validate-script.mjs",
    "v2:voices": "MATH140_EDITION=v2 TTS_PROVIDER=voicestudio node scripts/voice.mjs",
    "v2:lipsync": "MATH140_EDITION=v2 node scripts/lipsync.mjs",
    "v2:timing": "MATH140_EDITION=v2 node scripts/timing.mjs",
    "v2:audio": "npm run v2:script:check && npm run v2:voices && npm run v2:lipsync && npm run v2:timing",
    "v2:check": "node scripts/v2/check.mjs",
    "v2:export": "node scripts/v2/export.mjs",
    "v2:render": "node scripts/v2/check.mjs --require-audio && remotion render FriendlyV2 out/v2/final.mp4 --codec=h264 --pixel-format=yuv420p --audio-codec=aac --crf=18",
    "render:legacy": "remotion render Main out/final.mp4 --codec=h264 --pixel-format=yuv420p --audio-codec=aac --crf=18 --concurrency=50%",
    "produce:legacy": "npm run produce:audio && npm run qa:pre && npm run render:legacy && npm run qa:post",
    "v2:qa:post": "MATH140_EDITION=v2 node scripts/qa.mjs post out/v2/final.mp4",
    "v2:test:voice": "node scripts/v2/voice.test.mjs"
  }
}
